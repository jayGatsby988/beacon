# Copy to .env on an already-authorized host. Never commit .env.
BEACON_DOMAIN=beacon.example.org
ACME_EMAIL=operator@example.org
DATABASE_URL=postgresql://beacon_app:REPLACE_PASSWORD@REPLACE_TIGER_HOST:5432/tsdb
DB_SSL=require
# Optional PEM CA bundle when Tiger requires a non-system CA. Keep verification enabled.
# DB_CA_PEM="-----BEGIN CERTIFICATE-----..."
